load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(
    name = "connect-worker",
    # lib.rs pulls the README in as its crate documentation with
    # `#![doc = include_str!("../README.md")]`, so the file has to reach the
    # sandbox; the source glob covers `src/**/*.rs` and would leave it behind.
    compile_data = ["README.md"],
)

crate_binary(
    name = "krabka-connect-worker",
    crate_root = "src/main.rs",
    lib = "connect-worker",
)

crate_tests(
    data = [":krabka-connect-worker"],
    lib = "connect-worker",
    # postgres_cdc drives testcontainers: it starts Postgres and a Confluent
    # Schema Registry, and reaches the Docker daemon, which Bazel cannot
    # declare as an input. `manual` keeps it out of `//...`, and out of the
    # mutation sweep, which would otherwise rerun the whole container stack
    # once per mutant.
    manual = ["postgres_cdc"],
    mutants_jobs = 1,
    mutants_shards = 4,
    mutants_timeout = "eternal",
)
